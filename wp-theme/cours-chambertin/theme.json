{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink", "name": "Encre", "color": "#171310" },
        { "slug": "ink-soft", "name": "Encre douce", "color": "#6F685F" },
        { "slug": "craie", "name": "Craie", "color": "#F5F0E7" },
        { "slug": "blanc", "name": "Blanc", "color": "#FFFFFF" },
        { "slug": "accent", "name": "Bordeaux (Collège)", "color": "#8B1E2D" },
        { "slug": "accent-dark", "name": "Bordeaux foncé", "color": "#6c1622" },
        { "slug": "bleu", "name": "Bleu (École)", "color": "#245460" },
        { "slug": "bleu-dark", "name": "Bleu foncé", "color": "#163940" },
        { "slug": "or", "name": "Or", "color": "#B08A4F" },
        { "slug": "or-soft", "name": "Or doux", "color": "#C9AE8A" },
        { "slug": "footer-bg", "name": "Fond pied de page", "color": "#1E1613" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "montserrat",
          "name": "Montserrat",
          "fontFamily": "\"Montserrat\", -apple-system, \"Segoe UI\", Arial, sans-serif"
        },
        {
          "slug": "spectral",
          "name": "Spectral",
          "fontFamily": "\"Spectral\", Georgia, \"Times New Roman\", serif"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--blanc)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--montserrat)",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      },
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--spectral)", "fontWeight": "400" }
      }
    }
  }
}
